fixableIndividualDetails.IndividualFix.10.IndividualDetailsFix.caption=Rhowch eich manylion
fixableIndividualDetails.IndividualFix.10.IndividualDetailsFix.heading=Nid oeddem yn gallu paru’r manylion a roesoch gyda chofnod CThEF
fixableIndividualDetails.IndividualFix.10.IndividualDetailsFix.p1=Fel arfer, mae hyn oherwydd bod un o’r atebion a roddwyd gennych yn anghywir, neu oherwydd nad oeddech wedi rhoi digon o fanylion.
fixableIndividualDetails.IndividualFix.10.IndividualDetailsFix.p2=Ar y dudalen nesaf, gallwch adolygu rhai o’ch atebion.
fixableIndividualDetails.IndividualFix.10.IndividualDetailsFix.p3=Gwiriwch nhw, a newidiwch unrhyw beth sy’n anghywir neu ar goll.
fixableIndividualDetails.IndividualFix.10.IndividualDetailsFix.p4=Mae angen i chi wneud hyn erbyn <span class="govuk-!-font-weight-bold">{0}</span>.
individualDetailsDeclaration.caption=Cadarnhewch fod eich ymatebion yn rhai terfynol
individualDetailsDeclaration.title=Rydych ar fin cyflwyno’ch ymatebion
individualDetailsDeclaration.p1=Mae cyflwyno eich ymatebion yn golygu eich bod o’r farn eich bod wedi gwneud popeth sydd ei angen i fodloni’r amodau cofrestru.
individualDetailsDeclaration.p2=Ar ôl i chi gyflwyno, ni fyddwch yn gallu newid eich atebion.
individualDetailsFixConfirmation.title=Rydych wedi gorffen y broses hon
individualDetailsFixConfirmation.h2=Yr hyn sy’n digwydd nesaf
individualDetailsFixConfirmation.p1=Byddwn yn gofyn i {0} ailgyflwyno’r cais am gyfrif gwasanaethau asiant, pan fydd pawb wedi rhoi’r wybodaeth y mae ei hangen arnom.
individualDetailsFixConfirmation.p2=Byddwn yn anfon e-bost atoch chi yn {0} os bydd angen i ni gael unrhyw beth pellach gennych.
fixableFailuresDeclaration.title=Datganiad
fixableFailuresDeclaration.p1=Rydw i wedi cael fy awdurdodi gan {0} i wneud cais am gyfrif gwasanaethau asiant gyda CThEF.
fixableFailuresDeclaration.p1.SoleTrader=Rydw i wedi cymryd y camau sydd eu hangen i fodloni’r amodau cofrestru.
fixableFailuresDeclaration.p2=Mae’r wybodaeth a roddwyd gennyf yn y cais hwn yn gywir hyd eithaf fy ngwybodaeth.
resubmissionConfirmation.title=Rydych wedi ailgyflwyno’ch cais am gyfrif gwasanaethau asiant
resubmissionConfirmation.subtitle=Cyfeirnod y cais:
resubmissionConfirmation.whatNext.h2=Yr hyn sy’n digwydd nesaf
resubmissionConfirmation.whatNext.p1=Byddwn yn anfon e-bost atoch i gadarnhau bod eich cais wedi’i gyflwyno. Bydd yr e-bost yn rhoi gwybod i chi sut i olrhain cynnydd eich cais.
resubmissionConfirmation.viewLink=Gweld neu argraffu’ch cais
resubmissionConfirmation.decision.h2=Ein penderfyniad
resubmissionConfirmation.decision.p1=Byddwn yn cynnal rhai archwiliadau ar sail yr wybodaeth rydych wedi’i rhoi i ni. Os bydd angen rhagor o wybodaeth arnom, byddwn yn cysylltu â chi.
resubmissionConfirmation.decision.p2=Ein nod yw gwneud penderfyniad erbyn <span class="govuk-!-font-weight-bold">{0}</span>.
resubmissionConfirmation.decision.p3=Byddwn yn anfon e-bost at {0} i roi gwybod i chi am y canlyniad.
resubmissionConfirmation.signOutLink=Gorffen ac allgofnodi
soleTraderHasNoSaUtr.title=Ni allwch wneud cais am gyfrif gwasanaethau asiant eto
soleTraderHasNoSaUtr.p1=Mae angen i chi fod wedi’ch cofrestru ar gyfer Hunanasesiad a bod â Chyfeirnod Unigryw y Trethdalwr (UTR) i wneud cais am gyfrif gwasanaethau asiant.
soleTraderHasNoSaUtr.p2=Os oes gennych UTR eisoes, gallwch ei nodi drwy <a href="{0}" class="govuk-link">gadarnhau manylion eich busnes eto.</a>.
soleTraderHasNoSaUtr.p3=Os ydych wedi cofrestru ar gyfer Hunanasesiad, gallwch <a href="{0}" class="govuk-link">gael help i ddod o hyd i’ch UTR yma</a>.
soleTraderHasNoSaUtr.p4=Fel arall, gallwch <a href="{0}" class="govuk-link">gysylltu â CThEF</a>.

# Applicant deletes application to start again after risking decision
confirmDeleteApplication.title = Delete your application
confirmDeleteApplication.p1 = This action will happen immediately. You will no longer be able to access any details about your current application, including our decision.
confirmDeleteApplication.p2 = You can choose to start a new application when you are ready.
confirmDeleteApplication.p3 = HMRC carries out checks against all applications and any relevant individuals.
confirmDeleteApplication.label = Do you want to delete your application?
confirmDeleteApplication.Yes = Iawn
confirmDeleteApplication.No = Na
confirmDeleteApplication.error.required = Select yes if you want to delete your application
confirmDeleteApplication.error.invalid = Select yes if you want to delete your application

confirmationOfDeletion.title = We have deleted the application
confirmationOfDeletion.whatNext.h2 = Yr hyn sy’n digwydd nesaf
confirmationOfDeletion.whatNext.p1 = If you want to apply for an agent services account again, you can <a class="govuk-link" href="{0}">start a new application</a>.

signedOut.title = Rydych wedi allgofnodi
signedOut.link = Mewngofnodwch eto

# Application expired page
applicationExpired.title = Ni allwch barhau i lenwi’r cais hwn
applicationExpired.p1 = Gwnaethoch ddechrau’r cais hwn {0} diwrnod yn ôl neu fwy, ac ni wnaethoch ei gyflwyno.
applicationExpired.p2 = Gallwch ddileu’r cais hwn a dechrau un newydd.
applicationExpired.p3 = Os na fyddwch yn dileu’r cais hwn, byddwn yn ei ddileu ar ôl {0} diwrnod. Bydd gwneud hyn yn dileu’r holl wybodaeth a nodwyd gennych.

confirmationOfExpiredDeletion.title = Mae’ch cais wedi cael ei ddileu
confirmationOfExpiredDeletion.p1 = Mae’r holl wybodaeth a nodwyd gennych wedi’i ddileu oddi ar ein cronfa ddata.
confirmationOfExpiredDeletion.p2 = Os ydych am wneud cais am gyfrif gwasanaethau asiant o hyd, gallwch ddechrau cais newydd.

# Individual link id application expired
linkIdApplicationExpired.title = Ni allwch barhau â’r cais hwn
linkIdApplicationExpired.p1 = Cysylltwch â’r person a anfonodd y cysylltiad atoch.
